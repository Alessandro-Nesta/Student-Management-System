<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.springbootmybatisdemo.mapper.StudentClassMapper">

    <resultMap id="classDetailMap"
               type="com.example.springbootmybatisdemo.dto.StudentClassDetail">

        <id property="id" column="class_id"/>
        <result property="className" column="class_name"/>

        <collection property="students"
                    ofType="com.example.springbootmybatisdemo.entity.Student">

            <id property="id" column="student_id"/>
            <result property="name" column="student_name"/>
            <result property="age" column="student_age"/>
            <result property="classId" column="student_class_id"/>

        </collection>

    </resultMap>

    <select id="selectByIdWithStudents"
            resultMap="classDetailMap">

        SELECT
        sc.id AS class_id,
        sc.name AS class_name,
        s.id AS student_id,
        s.name AS student_name,
        s.age AS student_age,
        s.class_id AS student_class_id
        FROM student_class AS sc
        LEFT JOIN student AS s
        ON s.class_id = sc.id
        WHERE sc.id = #{id}
        ORDER BY s.id

    </select>




    <select id="selectIdById"
            resultType="java.lang.Integer">
        SELECT id
        FROM student_class
        WHERE id = #{id}
    </select>


</mapper>
